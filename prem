#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
# 0. ระบบตั้งค่าและตรวจสอบรหัสผ่าน
# ==========================================
SECRET_KEY="1234"     # <-- เปลี่ยนรหัสผ่านตรงนี้
MAX_ATTEMPTS=3

check_password() {
    clear
    printf "==========================================\r\n"
    printf "        INFINITE SHOP - VERIFICATION      \r\n"
    printf "==========================================\r\n"
    
    local ATTEMPTS=0
    while [ $ATTEMPTS -lt $MAX_ATTEMPTS ]; do
        read -s -p "กรุณาใส่รหัสผ่านเพื่อใช้งาน: " USER_PASS
        echo ""
        
        if [ "$USER_PASS" == "$SECRET_KEY" ]; then
            printf "[✓] เข้าสู่ระบบสำเร็จ!\r\n\r\n"
            sleep 1
            return 0
        else
            ATTEMPTS=$((ATTEMPTS + 1))
            REMAINING=$((MAX_ATTEMPTS - ATTEMPTS))
            if [ $REMAINING -gt 0 ]; then
                printf "[✗] รหัสผ่านไม่ถูกต้อง! (เหลืออีก $REMAINING ครั้ง)\r\n\r\n"
            fi
        fi
    done

    printf "[!] คุณใส่รหัสผ่านผิดเกินกำหนด ปิดการทำงานระบบ\r\n"
    exit 1
}

# ==========================================
# 1. ฟังก์ชันดาวน์โหลดและติดตั้ง (แก้ตัวหนังสือเบี้ยวแล้ว)
# ==========================================
install_apk() {
    local NAME=$1
    local URL=$2
    local TEMP_FILE="/sdcard/Download/temp_app.apk"

    printf "\r\n[+] Downloading: %s...\r\n" "$NAME"
    curl -sL "$URL" -o "$TEMP_FILE"

    if [ -f "$TEMP_FILE" ]; then
        printf "[+] Installing: %s...\r\n" "$NAME"
        
        # ป้องกัน Root Shell ทำตัวหนังสือเยื้อง
        su -c "pm install -r -g '$TEMP_FILE'" > /dev/null 2>&1
        local STATUS=$?

        if [ $STATUS -eq 0 ]; then
            printf "[✓] %s Installed Successfully!\r\n" "$NAME"
        else
            printf "[✗] Failed to install %s\r\n" "$NAME"
        fi
        rm -f "$TEMP_FILE"
    else
        printf "[✗] Download failed for %s\r\n" "$NAME"
    fi
}

# ==========================================
# 2. ฟังก์ชันแสดงรายการและรับค่าตัวเลือก
# ==========================================
process_selection() {
    local CATEGORY_NAME=$1
    shift
    local APPS=("$@")
    local TOTAL=${#APPS[@]}

    clear
    printf "==========================================\r\n"
    printf "          %s          \r\n" "$CATEGORY_NAME"
    printf "==========================================\r\n"
    for i in "${!APPS[@]}"; do
        printf "  [%d] %s Clone #%d\r\n" "$((i+1))" "$CATEGORY_NAME" "$((i+1))"
    done
    printf "==========================================\r\n"
    printf " ตัวอย่างการพิมพ์: 1-5 | 1 3 5 | all\r\n"
    printf "------------------------------------------\r\n"

    read -p "เลือกตัวโคลนที่ต้องการติดตั้ง: " INPUT_CHOICE

    local SELECTED_INDICES=()

    if [[ "$INPUT_CHOICE" == "all" || "$INPUT_CHOICE" == "ALL" ]]; then
        for i in "${!APPS[@]}"; do
            SELECTED_INDICES+=($i)
        done
    else
        for ITEM in $INPUT_CHOICE; do
            if [[ "$ITEM" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                START=${BASH_REMATCH[1]}
                END=${BASH_REMATCH[2]}
                for ((i=START; i<=END; i++)); do
                    SELECTED_INDICES+=($((i-1)))
                done
            elif [[ "$ITEM" =~ ^[0-9]+$ ]]; then
                SELECTED_INDICES+=($((ITEM-1)))
            fi
        done
    fi

    for INDEX in "${SELECTED_INDICES[@]}"; do
        if [ $INDEX -ge 0 ] && [ $INDEX -lt $TOTAL ]; then
            install_apk "$CATEGORY_NAME Clone #$((INDEX+1))" "${APPS[$INDEX]}"
        else
            printf "\r\n[!] หมายเลข %d ไม่มีในรายการ\r\n" "$((INDEX+1))"
        fi
    done
}

